# Minimal HK VPS live deployment example.
# Copy to /etc/polymarket-weather-arb.env and fill secrets on the server only.
# Optional/internal overrides are documented in ../../.env.advanced.example.

DATABASE_PATH=/opt/polymarket-weather-arb/data/polymarket_weather.db

# Keep this true until the full rehearsal and live-readiness checks are clean.
TRADING_DISABLED=true
COMPLIANCE_CHECK_ENABLED=true
COMPLIANCE_ALLOWED_COUNTRIES=HK

# Dedicated small wallet only. Never commit real values.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

WEATHER_PROVIDER=open-meteo
GOOGLE_WEATHER_API_KEY=

# Conservative starter caps. Raise them only from measured live performance.
MAX_ORDER_USDC=1
MAX_DAILY_USDC=5
MAX_MARKET_USDC=2
MIN_EDGE=0.05
SLIPPAGE_BUFFER=0.02

# Full Live always includes automatic exits.
MAX_AUTO_EXITS_PER_TICK=1
AUTO_EXIT_MAX_SLIPPAGE=0.02

# Autopilot production cadence. The systemd unit passes --full-auto explicitly.
AUTOPILOT_TICK_SECONDS=300

# Telegram notifications (optional)
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_MIN_LEVEL=trade

# Optional Cloudflare Access-protected Dashboard hostname.
# Example: https://weather.example.com (no path or trailing port).
DASHBOARD_PUBLIC_ORIGIN=
