# Advanced and internal overrides.
#
# Do not use this as a second environment file. Copy only the keys you actually
# need into .env. Defaults in Settings remain the source of truth otherwise.

# Polymarket endpoint overrides
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_GEOBLOCK_API_URL=https://polymarket.com/api/geoblock

# Read-only HTTP retry policy
HTTP_READ_MAX_RETRIES=3
HTTP_READ_MAX_BACKOFF_S=30

# Split proxy variables. PROXY_URL in .env is sufficient for most users.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1

# Micro Live only. Full Live always includes exits and ignores these two gates.
LIVE_MARKET_IDS=
AUTO_EXIT_ENABLED=false
AUTO_EXIT_MAX_POSITION_USDC=1

# Freshness policy
STALE_ORDER_BOOK_SECONDS=300
STALE_FORECAST_SECONDS=21600

# Optional LLM advisory source. Keep disabled unless calibration is intentional.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_MIN_CONFIDENCE=0.6
LLM_TIMEOUT_SECONDS=60
LLM_LANGUAGE=zh

# Optional exchange stream bridge. Weather production uses REST by default.
POLYMARKET_MARKET_STREAM_ENABLED=false

# Legacy China fixture/research module endpoints
CHINA_WEATHER_QINGDAO_URL=
CHINA_WEATHER_CHENGDU_URL=
CHINA_WEATHER_SHANGHAI_URL=
CHINA_WEATHER_WUHAN_URL=
CHINA_WEATHER_OPEN_METEO_FALLBACK=true

# Laptop-side remote monitoring helpers; not needed by the VPS process.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22
