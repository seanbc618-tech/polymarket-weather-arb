# Copy this file to .env. It contains only the settings most operators need.
# Optional/internal overrides live in .env.advanced.example; copy individual
# keys from there only when you have a specific reason.

DATABASE_PATH=./data/polymarket_weather.db

# Optional local outbound proxy. Leave blank for a direct connection.
PROXY_URL=

# Dedicated small wallet only. Never commit real values.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

# Fail closed by default. Change to false only after live-readiness passes.
TRADING_DISABLED=true
COMPLIANCE_CHECK_ENABLED=true
COMPLIANCE_ALLOWED_COUNTRIES=HK

# Forecast providers. Google Weather is optional.
WEATHER_PROVIDER=open-meteo
GOOGLE_WEATHER_API_KEY=

# Conservative starter caps in USDC.
MAX_ORDER_USDC=1
MAX_DAILY_USDC=5
MAX_MARKET_USDC=2
MIN_EDGE=0.05
SLIPPAGE_BUFFER=0.02

# Full Live always includes automatic exits. These are its execution bounds.
MAX_AUTO_EXITS_PER_TICK=1
AUTO_EXIT_MAX_SLIPPAGE=0.02

# Strategy cadence.
AUTOPILOT_TICK_SECONDS=300

# Telegram notifications (optional). trade avoids routine cycle noise.
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_MIN_LEVEL=trade

# Exact HTTPS origin for a Cloudflare Access-protected dashboard, or blank.
DASHBOARD_PUBLIC_ORIGIN=
